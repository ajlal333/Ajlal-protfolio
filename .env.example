# Booking form (Netlify Functions)
RESEND_API_KEY=your_resend_api_key
BOOKING_TO_EMAIL=ajlalgoraya333@gmail.com
BOOKING_FROM_EMAIL=LogicFolds <onboarding@resend.dev>

# Blog storage (Supabase). Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co

# Read-only in practice: row level security limits it to published posts.
# Used by the blog Netlify Functions and, as VITE_SUPABASE_ANON_KEY, by the browser.
SUPABASE_ANON_KEY=your_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Bypasses row level security. Publishing and seeding only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional. Overrides the site URL used for canonical, Open Graph and sitemap URLs.
# Netlify sets URL automatically in production, so this is only needed locally.
SITE_URL=https://logicfolds.example

# Optional product analytics (PostHog). Leaving VITE_POSTHOG_PROJECT_TOKEN unset
# disables analytics entirely — no third-party script loads. The token is a
# publishable key (safe in the browser); the library is served from PostHog's
# CDN, not bundled. Set the token in Netlify to activate.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# Defaults to https://us.i.posthog.com. Set to https://eu.i.posthog.com for EU.
VITE_POSTHOG_HOST=https://us.i.posthog.com
